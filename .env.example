# MariaDB & Frappe Administrator credentials
DB_PASSWORD=YourSecureDbPassword123!
ADMIN_PASSWORD=YourSecureAdminPassword123!

# Site configuration
SITE_NAME=menucka.local
FRAPPE_SITE_NAME_HEADER=menucka.local

# Frontend port mapping on the host
HTTP_PORT=8080

# VPS only (compose.vps.yaml): absolute path for bind-mounted data
# FRAPPE_DATA_DIR=/home/<user>/frappe/data
